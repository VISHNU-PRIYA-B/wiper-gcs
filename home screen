class HomeScreen extends StatefulWidget {
  final Task? task;
  final WiperTelemetry telemetry;

  const HomeScreen({super.key, this.task, required this.telemetry});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  late final WiperTelemetry _telemetry;

  @override
  void initState() {
    super.initState();
    _telemetry = widget.telemetry;
    // _telemetry.initConnection();
  }

  @override
  void dispose() {
    // _telemetry.disposeConnection();
    // _telemetry.dispose();
    super.dispose();
  }

  String _formatCompact(int val) {
    String s = val.toString();
    if (s.length > 4) {
      if (val > 9999) return '${val ~/ 1000}k';
      if (val < -999) return '${val ~/ 1000}k';
    }
    return s;
  }

  Widget _groupBox(String title, Color accent, List<Widget> tiles) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        GcsSectionLabel(title, color: accent),
        const SizedBox(height: 8),
        Container(
          width: double.infinity,
          padding: const EdgeInsets.all(14),
          decoration: BoxDecoration(
            color: AppTheme.bgCard,
            borderRadius: BorderRadius.circular(10),
            border: Border.all(color: AppTheme.borderDim),
          ),
          child: Wrap(spacing: 20, runSpacing: 16, children: tiles),
        ),
      ],
    );
  }

  //  Live camera feed(s) 

  Widget _liveCameras(BuildContext context) {
    final taskName = widget.task?.buildingName ?? 'Untitled Task';
    final camALink = widget.task?.cameraALink ?? '';
    // final camBLink = widget.task?.cameraBLink ?? '';

    return Column(
      crossAxisAlignment: CrossAxisAlignment.center,
      children: [
        GcsSectionLabel('Live Feed', color: AppTheme.cyan),
        const SizedBox(height: 8,width: 50,),
        LayoutBuilder(
          builder: (context, constraints) {
            final isWide = constraints.maxWidth >= 100;
            final cam1 = CameraView(
              url: camALink,
              label: 'Camera A',
              taskName: taskName,
              faceNumber: 1,
              
            );
            // final cam2 = CameraView(
            //   url: camBLink,
            //   label: 'Camera B',
            //   taskName: taskName,
            //   faceNumber: 2,
            // );

            if (isWide) {
              return Row(
                crossAxisAlignment: CrossAxisAlignment.end,
                children: [
                  const SizedBox(width: 16),
                  SizedBox(
                    width: 500,
                  
                  child: cam1,)
                  
                  // Expanded(child: cam2),
                ],
              );
            }
            return Column(
              children: [
                cam1,
                // const SizedBox(height: 16),
                // cam2,
              ],
            );
          },
        ),
      ],
    );
  }

  @override
  Widget build(BuildContext context) {
    final pad = AppTheme.screenPad(context);

    return Scaffold(
      backgroundColor: Colors.black,
      body: AnimatedBuilder(
        animation: _telemetry,
        builder: (context, _) {
          final t = _telemetry;

          return SingleChildScrollView(
            padding: EdgeInsets.symmetric(
              horizontal: pad,
              vertical: 16,
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  mainAxisAlignment: MainAxisAlignment.end,
                  children: [
                    StatusBadge(
                      label: 'LINK: ${t.connectionStatus}',
                      color: t.statusColor,
                    ),
                  ],
                ),

                const SizedBox(height: 16),
                _groupBox(
                  'Stabilization',
                  AppTheme.cyan,
                  [
                    InnerTeleTile(
                      label: 'CHAMBER A',
                      value: _formatCompact(t.chamberA),
                      unit: 'HPa',
                      icon: Icons.compress_rounded,
                      color: AppTheme.cyan,
                    ),
                    InnerTeleTile(
                      label: 'CHAMBER B',
                      value: _formatCompact(t.chamberB),
                      unit: 'HPa',
                      icon: Icons.compress_rounded,
                      color: AppTheme.cyan,
                    ),
                    InnerTeleTile(
                      label: 'THRUST 1',
                      value: _formatCompact(t.thrusterDc1),
                      unit: 'RPM',
                      icon: Icons.cyclone_rounded,
                      color: AppTheme.textMid,
                    ),
                    InnerTeleTile(
                      label: 'THRUST 2',
                      value: _formatCompact(t.thrusterDc2),
                      unit: 'RPM',
                      icon: Icons.cyclone_rounded,
                      color: AppTheme.textMid,
                    ),
                    InnerTeleTile(
                      label: 'IMPEL 1',
                      value: _formatCompact(t.impellerDc1),
                      unit: 'RPM',
                      icon: Icons.heat_pump,
                      color: AppTheme.textMid,
                    ),
                    InnerTeleTile(
                      label: 'IMPEL 2',
                      value: _formatCompact(t.impellerDc2),
                      unit: 'RPM',
                      icon: Icons.heat_pump,
                      color: AppTheme.textMid,
                    ),
                  ],
                ),

                const SizedBox(height: 20),

                // ── Cleaning Subs (left) + Cleaning Statistics (right) ──
                Row(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Expanded(
                      child: _groupBox(
                        'Cleaning Subs',
                        AppTheme.green,
                        [
                          InnerStatusTile(
                            label: 'BRUSH 1',
                            status: t.brush1 ? 'RUN' : 'OFF',
                            icon: Icons.change_circle_outlined,
                            color: t.brush1 ? AppTheme.cyan : AppTheme.textHi,
                          ),
                          InnerStatusTile(
                            label: 'BRUSH 2',
                            status: t.brush2 ? 'RUN' : 'OFF',
                            icon: Icons.change_circle_outlined,
                            color: t.brush2 ? AppTheme.cyan : AppTheme.textHi,
                          ),
                          InnerStatusTile(
                            label: 'WIPER 1',
                            status: t.wiper1 ? 'RUN' : 'OFF',
                            icon: Icons.change_circle_outlined,
                            color: t.wiper1 ? AppTheme.cyan : AppTheme.textHi,
                          ),
                          InnerStatusTile(
                            label: 'WIPER 2',
                            status: t.wiper2 ? 'RUN' : 'OFF',
                            icon: Icons.change_circle_outlined,
                            color: t.wiper2 ? AppTheme.cyan : AppTheme.textHi,
                          ),
                          InnerStatusTile(
                            label: 'PUMP',
                            status: t.pump ? 'RUN' : 'OFF',
                            icon: Icons.water_rounded,
                            color: t.pump ? AppTheme.cyan : AppTheme.textHi,
                          ),
                        ],
                      ),
                    ),
                    const SizedBox(width: 20),
                    Expanded(
                      child: _groupBox(
                        'Cleaning Statistics',
                        AppTheme.amber,
                        [
                          InnerTeleTile(
                            label: 'WATER USED',
                            value: t.waterUsed.toStringAsFixed(1),
                            unit: 'L',
                            icon: Icons.water_drop_rounded,
                            color: AppTheme.cyan,
                          ),
                          InnerTeleTile(
                            label: 'AREA CLEANED',
                            value: t.areaCleaned.toStringAsFixed(1),
                            unit: 'm2',
                            icon: Icons.square_foot_rounded,
                            color: AppTheme.green,
                          ),
                          InnerTeleTile(
                            label: 'ENERGY CONSUMED',
                            value: t.energyConsumed.toStringAsFixed(1),
                            unit: 'kWh',
                            icon: Icons.bolt_rounded,
                            color: AppTheme.amber,
                          ),
                        ],
                      ),
                    ),
                  ],
                ),

                const SizedBox(height: 20),
                _liveCameras(context),

                const SizedBox(height: 24),
              ],
            ),
          );
        },
      ),
    );
  }

  class _MappingTab extends StatelessWidget {
  final List<Offset> path;
  final double faceWidth;
  final double faceHeight;
  final int currentFace;
  final int totalFaces;
  final String faceName;
  final int currentStrip;
  final int totalStrips;
  final double currentY;
  final double currentX;
  final Task task;
  final VoidCallback onNextStretch;
  final VoidCallback onPrevStretch;
  final VoidCallback onNextFace;
  final VoidCallback onPrevFace;
  final Function(double, double) onDimensionsChanged;
  final int upCount;
  final int downCount;

  final Map<int, Map<String, int>> stripDirectionCounts;
  final ui.Image? botImage;

  

  const _MappingTab({
    required this.path,
    required this.faceWidth,
    required this.faceHeight,
    required this.currentFace,
    required this.totalFaces,
    required this.faceName,
    required this.currentStrip,
    required this.totalStrips,
    required this.currentY,
    required this.currentX,
    required this.task,
    required this.onNextStretch,
    required this.onPrevStretch,
    required this.onNextFace,
    required this.onPrevFace,
    required this.onDimensionsChanged,
    required this.upCount,
    required this.downCount,
    required this.stripDirectionCounts,
    required this.botImage,

  });

  double _faceProgress() {
    if (totalStrips <= 0) return 0;
    return (currentStrip / totalStrips * 100).clamp(0, 100);
  }

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.all(12.0),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // 👉 NEW COMPACT HEADER (No manual up/down arrows, no text on stretch buttons)
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 6),
            decoration: BoxDecoration(
              color: AppTheme.bgCard,
              borderRadius: BorderRadius.circular(8),
              border: Border.all(color: AppTheme.borderDim),
            ),
            child: SingleChildScrollView(
              scrollDirection: Axis.horizontal,
              child: Row(
                crossAxisAlignment: CrossAxisAlignment.center,
                children: [
                  GcsSectionLabel('Trajectory'),
                  const SizedBox(width: 12),

                  _FaceInputButton(
                    faceName: faceName,
                    currentFace: currentFace,
                    totalFaces: totalFaces,
                    faceProgress: _faceProgress(),
                    faceWidth: faceWidth,
                    faceHeight: faceHeight,
                    onDimensionsChanged: onDimensionsChanged,
                    onPrevFace: onPrevFace,
                    onNextFace: onNextFace,
                  ),

                  const SizedBox(width: 8),

                  Container(
                    padding: const EdgeInsets.symmetric(
                      horizontal: 8,
                      vertical: 4,
                    ),
                    decoration: BoxDecoration(
                      color: AppTheme.amber.withOpacity(0.15),
                      borderRadius: BorderRadius.circular(4),
                    ),
                    child: Text(
                      'STRIP ${currentStrip + 1}/$totalStrips',
                      style: GoogleFonts.jetBrainsMono(
                        fontSize: 10,
                        fontWeight: FontWeight.bold,
                        color: AppTheme.amber,
                      ),
                    ),
                  ),

                  const SizedBox(width: 16),

                  Text(
                    '↑$upCount ↓$downCount',
                    style: GoogleFonts.jetBrainsMono(
                      color: AppTheme.green,
                      fontWeight: FontWeight.bold,
                      fontSize: 14,
                    ),
                  ),

                  const SizedBox(width: 16),

                  IconButton(
                    icon: const Icon(
                      Icons.arrow_back_ios_rounded,
                      size: 20,
                      // color: Colors.white,
                      color: const Color(0xFF1ABECC),
                    ),
                    onPressed: onPrevStretch,
                    tooltip: "Previous Stretch",
                    constraints: const BoxConstraints(),
                    padding: const EdgeInsets.symmetric(
                      horizontal: 8,
                      vertical: 6,
                    ),
                  ),

                  IconButton(
                    icon: const Icon(
                      Icons.arrow_forward_ios_rounded,
                      size: 20,
                      color: const Color(0xFF1ABECC),
                    ),
                    onPressed: onNextStretch,
                    tooltip: "Next Stretch",
                    constraints: const BoxConstraints(),
                    padding: const EdgeInsets.symmetric(
                      horizontal: 8,
                      vertical: 6,
                    ),
                  ),
                ],
              ),
            ),
          ),

          const SizedBox(height: 12),

          Expanded(
            child: Column(
              children: [
                Expanded(
                  child: Row(
                    crossAxisAlignment: CrossAxisAlignment.stretch,
                    children: [
                      Container(
                        width: 28,
                        alignment: Alignment.center,
                        child: RotatedBox(
                          quarterTurns: 3,
                          child: Text(
                            'height: ${faceHeight.toStringAsFixed(0)}m',
                            style: GoogleFonts.jetBrainsMono(
                              fontSize: 11,
                              color: AppTheme.cyan,
                              letterSpacing: 1.5,
                            ),
                          ),
                        ),
                      ),
                      Expanded(
                        child: LayoutBuilder(
                          builder: (context, constraints) {
                            final size = Size(
                              constraints.maxWidth,
                              constraints.maxHeight,
                            );

                            final altitude = faceHeight - currentY;
                            final pct = (altitude / faceHeight * 100).clamp(
                              0.0,
                              100.0,
                            );
                            final widthCoveredPct = (currentX / faceWidth * 100)
                                .clamp(0.0, 100.0);
                            final widthRemaining = (faceWidth - currentX).clamp(
                              0.0,
                              faceWidth,
                            );

                            // Canvas is scrollable horizontally with fixed 50px strip width
                            final double fixedStripWidthPx = 50.0;
                            final double canvasWidth = max(
                              size.width,
                              totalStrips * fixedStripWidthPx,
                            );

                            return Stack(
                              children: [
                                Container(
                                  width: double.infinity,
                                  height: double.infinity,
                                  decoration: BoxDecoration(
                                    color: AppTheme.bgCard,
                                    border: Border.all(
                                      color: AppTheme.borderDim,
                                    ),
                                    borderRadius: BorderRadius.circular(8),
                                  ),
                                  child: ClipRect(
                                    child: SingleChildScrollView(
                                      scrollDirection: Axis.horizontal,
                                      child: SizedBox(
                                        width: canvasWidth,
                                        height: size.height,
                                        child: CustomPaint(
                                          painter: _RobotPathPainter(
                                            points: path,
                                            faceWidth: faceWidth,
                                            faceHeight: faceHeight,
                                            currentStrip: currentStrip,
                                            totalStrips: totalStrips,
                                            currentY: currentY,
                                            stripWidthPx: fixedStripWidthPx,
                                            stripDirectionCounts:
                                                stripDirectionCounts,
                                            upCount: upCount,
                                            downCount: downCount,
                                            botImage: botImage,
                                          ),
                                          size: Size(canvasWidth, size.height),
                                        ),
                                      ),
                                    ),
                                  ),
                                ),

                                Positioned(
                                  top: 16,
                                  right: 16,
                                  child: Container(
                                    padding: const EdgeInsets.symmetric(
                                      horizontal: 12,
                                      vertical: 10,
                                    ),
                                    decoration: BoxDecoration(
                                      color: AppTheme.bgCard.withOpacity(0.9),
                                      borderRadius: BorderRadius.circular(8),
                                      border: Border.all(
                                        color: AppTheme.cyan.withOpacity(0.6),
                                      ),
                                    ),
                                    child: Column(
                                      crossAxisAlignment:
                                          CrossAxisAlignment.start,
                                      mainAxisSize: MainAxisSize.min,
                                      children: [
                                        Row(
                                          mainAxisSize: MainAxisSize.min,
                                          crossAxisAlignment:
                                              CrossAxisAlignment.start,
                                          children: [
                                            Column(
                                              crossAxisAlignment:
                                                  CrossAxisAlignment.start,
                                              children: [
                                                Text(
                                                  'ALTITUDE',
                                                  style:
                                                      GoogleFonts.jetBrainsMono(
                                                        fontSize: 9,
                                                        color: AppTheme.textMid,
                                                        letterSpacing: 1.2,
                                                      ),
                                                ),
                                                const SizedBox(height: 4),
                                                Row(
                                                  mainAxisSize:
                                                      MainAxisSize.min,
                                                  crossAxisAlignment:
                                                      CrossAxisAlignment
                                                          .baseline,
                                                  textBaseline:
                                                      TextBaseline.alphabetic,
                                                  children: [
                                                    Text(
                                                      altitude.toStringAsFixed(
                                                        1,
