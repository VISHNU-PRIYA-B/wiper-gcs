class ReportService {
  static Map<String, double> _calculateCarbonSavings(
    double botEnergyKwh,
    double areaCleanedSqft,
  ) {
    const double gridEmissionFactor = 0.71;
    const double gondolaPowerKw = 3.0;
    const double manualSpeedSqftHr = 150.0;

    double botCarbon = botEnergyKwh * gridEmissionFactor;
    double manualHours = areaCleanedSqft / manualSpeedSqftHr;
    double traditionalEnergy = manualHours * gondolaPowerKw;
    double traditionalCarbon = traditionalEnergy * gridEmissionFactor;

    return {
      'botCO2': botCarbon,
      'traditionalCO2': traditionalCarbon,
      'savedCO2': traditionalCarbon - botCarbon,
    };
  }

  static Future<String?> generateMissionReport(Task task) async {
    try {
      final pdf = pw.Document();

      // Load Vividobots Logo
      final imageBytes = await rootBundle.load('lib/assets/image.png');
      final image = pw.MemoryImage(imageBytes.buffer.asUint8List());

      double area = task.areaCovered ?? 0.0;
      double water = task.waterUsed ?? 0.0;
      double energy = task.energyConsumed ?? 0.0;
      double totalArea = task.surfaceArea ?? 0.0;

      final esgData = _calculateCarbonSavings(energy, area);

      // Date logic
      DateTime displayDate = task.sessionDate ?? DateTime.now();

      // Changed to pw.Page and pw.Column to force a strict single-page layout
      pdf.addPage(
        pw.Page(
          pageFormat: PdfPageFormat.a4,
          margin: const pw.EdgeInsets.all(32),
          build: (pw.Context context) {
            return pw.Column(
              crossAxisAlignment: pw.CrossAxisAlignment.start,
              children: [
                // ── 1. HEADER ──
                pw.Row(
                  mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
                  crossAxisAlignment: pw.CrossAxisAlignment.center,
                  children: [
                    pw.Image(
                      image,
                      height:
                          65, // Slightly compressed to guarantee single page fit
                      fit: pw.BoxFit.contain,
                    ),
                    pw.Column(
                      crossAxisAlignment: pw.CrossAxisAlignment.end,
                      children: [
                        pw.Text(
                          'Wiperque Task Report',
                          style: pw.TextStyle(
                            fontSize: 16,
                            fontWeight: pw.FontWeight.bold,
                            color: PdfColors.blueGrey800,
                          ),
                        ),
                        pw.Text(
                          'DATE: ${displayDate.toString().split('.')[0]}',
                          style: const pw.TextStyle(
                            fontSize: 10,
                            color: PdfColors.grey700,
                          ),
                        ),
                      ],
                    ),
                  ],
                ),

                pw.SizedBox(height: 10),
                pw.Divider(thickness: 1.5, color: PdfColors.blueGrey200),
                pw.SizedBox(height: 15),

                // ── 2. DETAILS SECTION ──
                pw.Text(
                  'Task Details',
                  style: pw.TextStyle(
                    fontSize: 13,
                    color: PdfColors.black,
                    fontWeight: pw.FontWeight.bold,
                  ),
                ),
                pw.SizedBox(height: 8),

                _buildRow("Building:", task.buildingName ?? 'N/A'),
                _buildRow("Device ID:", task.deviceId ?? 'N/A'),
                _buildRow("Target Area:", "$totalArea sq.ft"),
                _buildRow("Session Status:", task.status ?? 'PENDING'),

                pw.SizedBox(height: 20),

                // ── 3. METRICS TABLE ──
                pw.Text(
                  'Performance & ESG Metrics',
                  style: pw.TextStyle(
                    fontSize: 13,
                    color: PdfColors.black,
                    fontWeight: pw.FontWeight.bold,
                  ),
                ),
                pw.SizedBox(height: 8),
                pw.TableHelper.fromTextArray(
                  context: context,
                  headerStyle: pw.TextStyle(
                    fontWeight: pw.FontWeight.bold,
                    color: PdfColors.white,
                    fontSize: 10,
                  ),
                  cellStyle: const pw.TextStyle(fontSize: 10),
                  headerDecoration: const pw.BoxDecoration(
                    color: PdfColors.cyan700,
                  ),
                  rowDecoration: const pw.BoxDecoration(
                    border: pw.Border(
                      bottom: pw.BorderSide(color: PdfColors.grey300),
                    ),
                  ),
                  cellAlignment: pw.Alignment.centerLeft,
                  data: <List<String>>[
                    ['Metric', 'Recorded Value', 'Unit'],
                    ['Area Cleaned', area.toStringAsFixed(1), 'sq.ft'],
                    ['Water Used', water.toStringAsFixed(1), 'Liters'],
                    ['Energy Consumed', energy.toStringAsFixed(2), 'kWh'],
                    [
                      'Robot CO2 Emission',
                      esgData['botCO2']!.toStringAsFixed(2),
                      'kg',
                    ],
                    [
                      'Traditional CO2 Emission',
                      esgData['traditionalCO2']!.toStringAsFixed(2),
                      'kg',
                    ],
                    [
                      'Total Carbon Saved',
                      esgData['savedCO2']!.toStringAsFixed(2),
                      'kg',
                    ],
                  ],
                ),

                pw.SizedBox(height: 30),

                // ── 4. DATA VISUALIZATION (CHARTS) ──
                pw.Text(
                  'Statistics Visualization',
                  style: pw.TextStyle(
                    fontSize: 13,
                    color: PdfColors.black,
                    fontWeight: pw.FontWeight.bold,
                  ),
                ),
                pw.SizedBox(height: 10),

                // ROW 1: Area and Water Charts
                pw.Row(
                  children: [
                    pw.Expanded(
                      child: _buildPerformanceChart(
                        "Area Cleaned Progress",
                        task.areaHistoryPersisted,
                        PdfColors.green700,
                        "sq.ft",
                      ),
                    ),
                    pw.SizedBox(width: 15),
                    pw.Expanded(
                      child: _buildPerformanceChart(
                        "Water Usage Curve",
                        task.waterHistoryPersisted,
                        PdfColors.cyan700,
                        "Liters",
                      ),
                    ),
                  ],
                ),

                pw.SizedBox(height: 15),

                // ROW 2: Energy Chart
                pw.Row(
                  children: [
                    pw.Expanded(
                      child: _buildPerformanceChart(
                        "Energy Consumption",
                        task.energyHistoryPersisted,
                        // PdfColors.amber700,sample
                        PdfColors.amber700,
                        "kWh",
