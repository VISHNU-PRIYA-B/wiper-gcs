class WiperMainScreen extends StatefulWidget {
  final Task task;
  final bool isActive;

  const WiperMainScreen({
    super.key,
    required this.task,
    required this.isActive,
  });

  @override
  State<WiperMainScreen> createState() => _WiperMainScreenState();
}

class _WiperMainScreenState extends State<WiperMainScreen>
    with TickerProviderStateMixin {
  late TabController _tabCtrl;
  late final WiperTelemetry _telemetry;
  int _tab = 0;

  int _currentStrip = 0;
  int get _totalStrips => (_faceWidth / _robotCleaningWidth).floor();

  int _currentFace = 1;
  double _faceStartY = 0.0;

  double _faceWidth = 0.0;
  double _faceHeight = 0.0;

  int _upCount = 0;
  int _downCount = 0;

  // Track if bot has touched the top/bottom boundary to prevent multiple counts
  bool _isAtTop = false;
  bool _isAtBottom = true;

  Map<int, Map<int, Map<String, int>>> _faceStripCounts = {};
  Map<int, Map<String, double>> _faceSnapshot = {};

  late final FlutterTts _tts;
  bool _waterWarningPlayed = false;
  bool _batteryWarningPlayed = false;

  Timer? _autoSaveTimer;
  double _lastSavedWater = 0;
  double _lastSavedEnergy = 0;

  ui.Image? _botImage;
  List<Offset> _robotPath = [];
  double _currentX = 0.0;
  double _currentY = 0.0;
  final double _robotCleaningWidth = 0.9;

  @override
  void initState() {
    super.initState();
    _currentStrip = widget.task.currentStrip;
    _currentFace = widget.task.currentFace;

    _faceHeight = widget.task.buildingHeight > 0
        ? widget.task.buildingHeight
        : 50.0;
    int facesCount =
        widget.task.numberOfFaces != null && widget.task.numberOfFaces! > 0
        ? widget.task.numberOfFaces!
        : 1;
    _faceWidth = (widget.task.surfaceArea / (_faceHeight * facesCount)).clamp(
      1.0,
      double.infinity,
    );

    // DECODE PERSISTENT HISTORY FROM ISAR
    if (widget.task.mappingState.isNotEmpty &&
        widget.task.mappingState != "{}") {
      try {
        final Map<String, dynamic> state = jsonDecode(widget.task.mappingState);
        _upCount = state['upCount'] ?? 0;
        _downCount = state['downCount'] ?? 0;
        _currentX = state['currentX'] ?? 0.0;
        _currentY = state['currentY'] ?? _faceHeight;

        if (state['faceStripCounts'] != null) {
          final decodedFSC = Map<String, dynamic>.from(
            state['faceStripCounts'],
          );
          decodedFSC.forEach((faceStr, stripMap) {
            int faceId = int.parse(faceStr);
            _faceStripCounts[faceId] = {};
            Map<String, dynamic>.from(stripMap).forEach((stripStr, countMap) {
              _faceStripCounts[faceId]![int.parse(stripStr)] =
                  Map<String, int>.from(countMap);
            });
          });
        }
      } catch (e) {
        debugPrint("Error decoding mapping state: $e");
        _resetToBottom();
      }
    } else {
      _resetToBottom();
    }

    _initTabController();

    _telemetry = WiperTelemetry();
    _telemetry.addListener(_processOdometry);

    _tts = FlutterTts();
    _tts.setLanguage("en-US");
    _tts.setSpeechRate(0.5);

    if (widget.isActive) {
      _telemetry.initConnection();
      _autoSaveTimer = Timer.periodic(
        const Duration(seconds: 5),
        (_) => _saveTelemetryToTask(),
      );
    }

    const AssetImage('assets/bot_image.png')
        .resolve(const ImageConfiguration())
        .addListener(
          ImageStreamListener((ImageInfo info, bool _) {
            if (mounted) setState(() => _botImage = info.image);
          }),
        );
  }

  void _resetToBottom() {
    // 1. Calculate strips
    final int totalS = (_faceWidth / _robotCleaningWidth).floor();
    final double stripWidth = totalS > 0 ? _faceWidth / totalS : _faceWidth;

    // 2. Put the bot exactly in the horizontal center of the face
    _currentX = (_currentStrip * stripWidth) + (stripWidth / 2);

    // 3. Put the bot at the exact bottom of the face (ground level)
    _currentY = _faceHeight; // Bot defaults to bottom center
    _faceStartY = _currentY;

    // 4. Update the visual path and default direction (moving UP from ground)
    _robotPath = [Offset(_currentX, _currentY)];
  }

  void _processOdometry() {
    if (!widget.isActive) return;

    // SYNC WITH TELEMETRY ALTITUDE
    // Assuming telemetry.altitude is in meters from the ground.
    // So currentY (pixels from top) = totalHeight - altitude.
    double newY = (_faceHeight - _telemetry.altitude).clamp(0.0, _faceHeight);

    // Only redraw if the bot actually moved a noticeable amount
    if ((_currentY - newY).abs() > 0.1) {
      setState(() {
        _currentY = newY;
        _robotPath.add(Offset(_currentX, _currentY));

        // COUNTER LOGIC
        if (_currentY <= 0.5 && !_isAtTop) {
          _isAtTop = true;
          _isAtBottom = false;
          _upCount++;
        } else if (_currentY >= (_faceHeight - 0.5) && !_isAtBottom) {
          _isAtBottom = true;
          _isAtTop = false;
          _downCount++;
        } else if (_currentY > 0.5 && _currentY < (_faceHeight - 0.5)) {
          _isAtTop = false;
          _isAtBottom = false;
        }
      });
    }
  }

  void _saveAndResetCounts() {
    _faceStripCounts[_currentFace] ??= {};
    _faceStripCounts[_currentFace]![_currentStrip] = {
      'up': _upCount,
      'down': _downCount,
    };
    _faceSnapshot[_currentFace] = {
      'strip': _currentStrip.toDouble(),
      'y': _currentY,
    };
    _upCount = 0;
    _downCount = 0;
  }

  void _restoreCounts(int face, int strip) {
    _upCount = _faceStripCounts[face]?[strip]?['up'] ?? 0;
    _downCount = _faceStripCounts[face]?[strip]?['down'] ?? 0;
  }

  String _faceName(int face) {
    switch (face) {
      case 1:
        return 'FACE-1';
      case 2:
        return 'FACE-2';
      case 3:
        return 'FACE-3';
      case 4:
        return 'FACE-4';
      default:
        return 'FACE $face';
    }
  }

  List<_Tab> get _currentTabs {
    var tabs = [
      const _Tab(
        'TELEMETRY',
        Icons.analytics_outlined,
        Icons.analytics_rounded,
      ),
      const _Tab('VISION', Icons.videocam_outlined, Icons.videocam_rounded),
      const _Tab('MAPPING', Icons.map_outlined, Icons.map_rounded),
      const _Tab(
        'STATISTICS',
        Icons.bar_chart_outlined,
        Icons.bar_chart_rounded,
      ),
      const _Tab('CONFIG', Icons.tune_outlined, Icons.tune_rounded),
    ];

    if (widget.task.snapshots.isNotEmpty) {
      tabs.add(
        const _Tab(
          'SNAPS',
          Icons.photo_library_outlined,
          Icons.photo_library_rounded,
        ),
      );
    }
    if (widget.task.videos.isNotEmpty) {
      tabs.add(
        const _Tab(
          'VIDEOS',
          Icons.video_collection_outlined,
          Icons.video_collection_rounded,
        ),
      );
    }
    if (widget.task.alerts.isNotEmpty) {
      tabs.add(
        const _Tab(
          'ALERTS',
          Icons.warning_amber_outlined,
          Icons.warning_rounded,
        ),
      );
    }
    return tabs;
  }

  void _initTabController() {
    _tabCtrl = TabController(
      length: _currentTabs.length,
      vsync: this,
      initialIndex: _tab >= _currentTabs.length ? 0 : _tab,
    );
    _tabCtrl.addListener(() {
      if (_tabCtrl.indexIsChanging) return;
      setState(() => _tab = _tabCtrl.index);
    });
  }

  void _refreshTabs() {
    setState(() {
      _tabCtrl.dispose();
      _initTabController();
    });
  }

  // ENCODES HISTORY SO IT PERSISTS FOREVER
  String _buildMappingStateJson() {
    final Map<String, dynamic> fscStringMap = {};
    _faceStripCounts.forEach((faceKey, stripMap) {
      final Map<String, dynamic> sMap = {};
      stripMap.forEach((stripKey, counts) {
        sMap[stripKey.toString()] = counts;
      });
      fscStringMap[faceKey.toString()] = sMap;
    });

    return jsonEncode({
      'upCount': _upCount,
      'downCount': _downCount,
      'currentX': _currentX,
      'currentY': _currentY,
      'faceSnapshot': _faceSnapshot,
      'faceStripCounts': fscStringMap,
    });
  }

  void _saveTelemetryToTask() async {
    if (!widget.isActive) return;

    List<AlertLog> newAlerts = [];

    if (_telemetry.waterLevel < 10.0 && !_waterWarningPlayed) {
      _tts.speak("Warning. Water level is critically low.");
      newAlerts.add(
        AlertLog()
          ..timestamp = DateTime.now()
          ..message = "Water Level Critical (<5%)"
          ..type = "CRITICAL",
      );
      _waterWarningPlayed = true;
    }

    if (_telemetry.batteryLevel < 10.0 && !_batteryWarningPlayed) {
      _tts.speak("Warning. Battery level low. Please return to base.");
      newAlerts.add(
        AlertLog()
          ..timestamp = DateTime.now()
          ..message = "Battery Low (<10%)"
          ..type = "WARNING",
      );
      _batteryWarningPlayed = true;
    }

    double diffWater = _telemetry.waterUsed - _lastSavedWater;
    double diffEnergy = _telemetry.energyConsumed - _lastSavedEnergy;

    if (diffWater > 0 ||
        diffEnergy > 0 ||
        newAlerts.isNotEmpty ||
        _robotPath.isNotEmpty) {
      _lastSavedWater = _telemetry.waterUsed;
      _lastSavedEnergy = _telemetry.energyConsumed;

      final isar = IsarService.isar;
      await isar.writeTxn(() async {
        final latestTask = await isar.tasks.get(widget.task.id);
        if (latestTask != null) {
          latestTask.waterUsed = (latestTask.waterUsed) + diffWater;
          latestTask.energyConsumed = (latestTask.energyConsumed) + diffEnergy;

          latestTask.currentFace = _currentFace;
          latestTask.currentStrip = _currentStrip;
          latestTask.mappingState = _buildMappingStateJson();

          if (newAlerts.isNotEmpty) {
            latestTask.alerts = List.from(latestTask.alerts)..addAll(newAlerts);
          }
          latestTask.isSynced = false;
          await isar.tasks.put(latestTask);

          if (mounted) {
            setState(() {
              widget.task.waterUsed = latestTask.waterUsed;
              widget.task.energyConsumed = latestTask.energyConsumed;
              widget.task.alerts = latestTask.alerts;
            });
            if (newAlerts.isNotEmpty) _refreshTabs();
          }
        }
      });
    }
  }

  @override
  void dispose() {
    _autoSaveTimer?.cancel();
    _saveTelemetryToTask();
    _telemetry.removeListener(_processOdometry);
    _telemetry.disposeConnection();
    _telemetry.dispose();
    _tabCtrl.dispose();
    super.dispose();
  }

  Future<void> _stopMission() async {
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(content: Text('Ending mission and saving telemetry...')),
    );
    try {
      _autoSaveTimer?.cancel();

      final isar = IsarService.isar;
      await isar.writeTxn(() async {
        final latestTask = await isar.tasks.get(widget.task.id);
        if (latestTask != null) {
          latestTask.sessionDate = DateTime.now();
          latestTask.status = "COMPLETED";
          latestTask.currentFace = _currentFace;
          latestTask.currentStrip = _currentStrip;
          latestTask.mappingState = _buildMappingStateJson();
          latestTask.isSynced = false;
          await isar.tasks.put(latestTask);
        }
      });

      _telemetry.disposeConnection();

      if (mounted) Navigator.pop(context);
    } catch (e) {
      debugPrint("Failed to save mission data: $e");
    }
  }

  List<SidebarItem> _sidebarItems(BuildContext ctx) => [
    SidebarItem(
      icon: Icons.water_drop_rounded,
      label: 'Task List',
      sublabel: 'Return',
      onTap: () => Navigator.pop(ctx),
    ),
    if (widget.isActive)
      SidebarItem(
        icon: Icons.stop_circle_outlined,
        label: 'End Mission',
        sublabel: 'Save & Exit',
        accent: AppTheme.red,
        onTap: _stopMission,
      ),
  ];

  @override
  Widget build(BuildContext context) {
    final isWide = MediaQuery.of(context).size.width >= 600;

    return GcsScaffold(
      screenTitle: widget.task.buildingName ?? 'Unknown',
      screenCode: 'WIPER · #${widget.task.id.toString().padLeft(4, '0')}',
      accentColor: widget.isActive ? AppTheme.green : AppTheme.cyan,
      items: _sidebarItems(context),
      activeIndex: _tab,
      body: Column(
        children: [
          _TabStrip(
            tabs: _currentTabs,
            current: _tab,
            isWide: isWide,
            onTap: (i) {
              _tabCtrl.animateTo(i);
              setState(() => _tab = i);
            },
          ),
          Expanded(
            child: TabBarView(
              controller: _tabCtrl,
              physics: const BouncingScrollPhysics(),
              children: [
                TelemetrySection(
                  task: widget.task,
                  isWide: isWide,
                  telemetry: _telemetry,
                ),
                _VisionTab(
                  task: widget.task,
                  isWide: isWide,
                  onSnapshot: (path, time, camName, isIssue, issueDesc) async {
                    final isar = IsarService.isar;
                    await isar.writeTxn(() async {
                      final latestTask = await isar.tasks.get(widget.task.id);
                      if (latestTask != null) {
                        bool wasEmpty = latestTask.snapshots.isEmpty;
                        latestTask.snapshots = List.from(latestTask.snapshots)
                          ..add(
                            TaskSnapshot()
                              ..filePath = path
                              ..timestamp = time
                              ..cameraName = camName
                              ..isIssue = isIssue
                              ..issueDescription = issueDesc,
                          );
                        latestTask.isSynced = false;
                        await isar.tasks.put(latestTask);
                        if (mounted) {
                          setState(
                            () => widget.task.snapshots = latestTask.snapshots,
                          );
                          if (wasEmpty) _refreshTabs();
                        }
                      }
                    });
                  },
                  onVideoRecorded: (path, time, camName) async {
                    final isar = IsarService.isar;
                    await isar.writeTxn(() async {
                      final latestTask = await isar.tasks.get(widget.task.id);
                      if (latestTask != null) {
                        bool exists = latestTask.videos.any(
                          (v) => v.filePath == path,
                        );
                        if (!exists) {
                          bool wasEmpty = latestTask.videos.isEmpty;
                          latestTask.videos = List.from(latestTask.videos)
                            ..add(
                              TaskVideo()
                                ..filePath = path
                                ..timestamp = time
                                ..cameraName = camName,
                            );
                          latestTask.isSynced = false;
                          await isar.tasks.put(latestTask);
                          if (mounted) {
                            setState(
                              () => widget.task.videos = latestTask.videos,
                            );
                            if (wasEmpty) _refreshTabs();
                          }
                        }
                      }
                    });
                  },
                ),
                _MappingTab(
                  path: _robotPath,
                  faceWidth: _faceWidth,
                  faceHeight: _faceHeight,
                  currentFace: _currentFace,
                  totalFaces: widget.task.numberOfFaces ?? 1,
                  faceName: _faceName(_currentFace),
                  currentStrip: _currentStrip,
                  totalStrips: _totalStrips,
                  currentY: _currentY,
                  currentX: _currentX,
                  upCount: _upCount,
                  downCount: _downCount,
                  stripDirectionCounts: Map<int, Map<String, int>>.from(
                    _faceStripCounts[_currentFace] ?? {},
                  ),
                  botImage: _botImage,
                  task: widget.task,
                  onDimensionsChanged: (w, h) async {
                    setState(() {
                      _faceWidth = w;
                      _faceHeight = h;
                      _currentStrip = 0;
                      _currentFace = 1;
                      _faceStripCounts = {};
                      _faceSnapshot = {};
                      _upCount = 0;
                      _downCount = 0;
                      _resetToBottom();
                    });
                    final isar = IsarService.isar;
                    await isar.writeTxn(() async {
                      final latestTask = await isar.tasks.get(widget.task.id);
                      if (latestTask != null) {
                        latestTask.surfaceArea = widget.task.surfaceArea;
                        latestTask.buildingHeight = widget.task.buildingHeight;
                        latestTask.currentStrip = _currentStrip;
                        latestTask.currentFace = _currentFace;
                        latestTask.mappingState = _buildMappingStateJson();
                        await isar.tasks.put(latestTask);
                      }
                    });
                  },
                  onNextStretch: () async {
                    setState(() {
                      _faceStripCounts[_currentFace] ??= {};
                      _faceStripCounts[_currentFace]![_currentStrip] = {
                        'up': _upCount,
                        'down': _downCount,
                      };

                      final int totalS = (_faceWidth / _robotCleaningWidth)
                          .floor();
                      final double stripWidth = totalS > 0
                          ? _faceWidth / totalS
                          : _faceWidth;

                      _currentStrip++;
                      widget.task.currentStrip = _currentStrip;

                      if (_currentStrip >= totalS) {
                        if (_currentFace < (widget.task.numberOfFaces ?? 1)) {
                          _currentFace++;
                          _currentStrip = 0;
                          widget.task.currentFace = _currentFace;
                          widget.task.currentStrip = 0;
                          _restoreCounts(_currentFace, _currentStrip);
                          _resetToBottom();
                        } else {
                          _currentStrip = totalS > 0 ? totalS - 1 : 0;
                          showDialog(
                            context: context,
                            builder: (ctx) => AlertDialog(
                              backgroundColor: AppTheme.bgPanel,
                              title: Text(
                                'Mission Complete!',
                                style: TextStyle(color: AppTheme.green),
                              ),
                              content: Text(
                                'All faces and strips have been completed.',
                                style: TextStyle(color: AppTheme.textHi),
                              ),
                              actions: [
                                TextButton(
                                  onPressed: () => Navigator.pop(ctx),
                                  child: Text(
                                    'OK',
                                    style: TextStyle(color: AppTheme.cyan),
                                  ),
                                ),
                              ],
                            ),
                          );
                        }
                      } else {
                        _currentX =
                            (_currentStrip * stripWidth) + (stripWidth / 2);
                        _robotPath = [Offset(_currentX, _currentY)];
                        _restoreCounts(_currentFace, _currentStrip);
                      }
                    });
                    final isar = IsarService.isar;
                    await isar.writeTxn(() async {
                      final latestTask = await isar.tasks.get(widget.task.id);
                      if (latestTask != null) {
                        latestTask.currentStrip = _currentStrip;
                        latestTask.currentFace = _currentFace;
                        latestTask.mappingState = _buildMappingStateJson();
                        await isar.tasks.put(latestTask);
                      }
                    });
                  },
                  onPrevStretch: () async {
                    setState(() {
                      _faceStripCounts[_currentFace] ??= {};
                      _faceStripCounts[_currentFace]![_currentStrip] = {
                        'up': _upCount,
                        'down': _downCount,
                      };

                      if (_currentStrip > 0) {
                        _currentStrip--;
                        widget.task.currentStrip = _currentStrip;
                        final int totalS = (_faceWidth / _robotCleaningWidth)
                            .floor();
                        final double stripWidth = totalS > 0
                            ? _faceWidth / totalS
                            : _faceWidth;
                        _currentX =
                            (_currentStrip * stripWidth) + (stripWidth / 2);
                        _robotPath = [Offset(_currentX, _currentY)];
                        _restoreCounts(_currentFace, _currentStrip);
                      } else if (_currentFace > 1) {
                        _currentFace--;
                        widget.task.currentFace = _currentFace;
                        final int totalS = (_faceWidth / _robotCleaningWidth)
                            .floor();
                        final double stripWidth = totalS > 0
                            ? _faceWidth / totalS
                            : _faceWidth;
                        _currentStrip = totalS > 0 ? totalS - 1 : 0;
                        widget.task.currentStrip = _currentStrip;
                        _currentX =
                            (_currentStrip * stripWidth) + (stripWidth / 2);
                        _robotPath = [Offset(_currentX, _currentY)];
                        _restoreCounts(_currentFace, _currentStrip);
                      }
                    });
                    final isar = IsarService.isar;
                    await isar.writeTxn(() async {
                      final latestTask = await isar.tasks.get(widget.task.id);
                      if (latestTask != null) {
                        latestTask.currentStrip = _currentStrip;
                        latestTask.currentFace = _currentFace;
                        latestTask.mappingState = _buildMappingStateJson();
                        await isar.tasks.put(latestTask);
                      }
                    });
                  },
                  onNextFace: () async {
                    setState(() {
                      if (_currentFace < (widget.task.numberOfFaces ?? 1)) {
                        // 1. Save current face progress
                        _saveAndResetCounts();

                        // 2. Advance face
                        _currentFace++;
                        widget.task.currentFace = _currentFace;
                        _currentStrip = 0;

                        // 3. Reset bot to bottom-center of new face
                        _resetToBottom();
                        _restoreCounts(_currentFace, _currentStrip);
                        _robotPath = [Offset(_currentX, _currentY)];
                      }
                    });

                    // 4. Persistent Save
                    final isar = IsarService.isar;
                    await isar.writeTxn(() async {
                      final latestTask = await isar.tasks.get(widget.task.id);
                      if (latestTask != null) {
                        latestTask.currentStrip = _currentStrip;
                        latestTask.currentFace = _currentFace;
                        latestTask.mappingState =
                            _buildMappingStateJson(); // Saving the history
                        await isar.tasks.put(latestTask);
                      }
                    });
                  },

                  // onPrevFace: () async {
                  //   setState(() {
                  //     if (_currentFace > 1) {
                  //       _saveAndResetCounts();
                  //       _currentFace--;
                  //       widget.task.currentFace = _currentFace;
                  //       _currentStrip = 0;
                  //       _resetToBottom();
                  //       _restoreCounts(_currentFace, _currentStrip);
                  //       _robotPath = [];
                  //     }
                  //   });
                  //   final isar = IsarService.isar;
                  //   await isar.writeTxn(() async {
                  //     final latestTask = await isar.tasks.get(widget.task.id);
                  //     if (latestTask != null) {
                  //       latestTask.currentStrip = _currentStrip;
                  //       latestTask.currentFace = _currentFace;
                  //       latestTask.mappingState = _buildMappingStateJson();
                  //       await isar.tasks.put(latestTask);
                  //     }
                  //   });
                  // },
                  onPrevFace: () async {
                    setState(() {
                      if (_currentFace > 1) {
                        // 1. Save current state
                        _saveAndResetCounts();

                        // 2. Go back
                        _currentFace--;
                        widget.task.currentFace = _currentFace;

                        // 3. Restore last known position (X, Y, Strip) from the snapshot
                        final snap = _faceSnapshot[_currentFace];
                        if (snap != null) {
                          _currentStrip = snap['strip']!.toInt();
                          _currentY = snap['y']!;
                          final int totalS = (_faceWidth / _robotCleaningWidth)
                              .floor();
                          final double stripWidth = totalS > 0
                              ? _faceWidth / totalS
                              : _faceWidth;
                          _currentX =
                              (_currentStrip * stripWidth) + (stripWidth / 2);
                        } else {
                          // Fallback if no snapshot
                          _currentStrip = 0;
                          _resetToBottom();
                        }
                        _restoreCounts(_currentFace, _currentStrip);
                        _robotPath = [Offset(_currentX, _currentY)];
                      }
                    });

                    final isar = IsarService.isar;
                    await isar.writeTxn(() async {
                      final latestTask = await isar.tasks.get(widget.task.id);
                      if (latestTask != null) {
                        latestTask.currentStrip = _currentStrip;
                        latestTask.currentFace = _currentFace;
