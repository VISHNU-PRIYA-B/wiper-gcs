  });

  @override
  void paint(Canvas canvas, Size size) {
    final safeWidth = faceWidth > 0 ? faceWidth : 1.0;
    final safeHeight = faceHeight > 0 ? faceHeight : 1.0;

    // Scale X physical meters to pixel width of the canvas
    final scaleX = size.width / safeWidth;
    final scaleY = size.height / safeHeight;

    final glassRect = Rect.fromLTWH(0, 0, size.width, size.height);
    canvas.drawRect(
      glassRect,
      Paint()
        ..color = AppTheme.cyan.withOpacity(0.05)
        ..style = PaintingStyle.fill,
    );
    canvas.drawRect(
      glassRect,
      Paint()
        ..color = AppTheme.cyan.withOpacity(0.3)
        ..strokeWidth = 1.0
        ..style = PaintingStyle.stroke,
    );

    for (int i = 0; i < totalStrips; i++) {
      final stripLeft = i * stripWidthPx;
      if (i < currentStrip) {
        canvas.drawRect(
          Rect.fromLTWH(stripLeft, 0, stripWidthPx, size.height),
          Paint()
            ..color = AppTheme.cyan.withOpacity(0.35)
            ..style = PaintingStyle.fill,
        );
      } else if (i == currentStrip) {
        final cleanedFraction = currentY / safeHeight;
        final cleanedHeightPx = cleanedFraction * size.height;
        // Paint from TOP (0) to currentY
        canvas.drawRect(
          Rect.fromLTWH(stripLeft, 0, stripWidthPx, cleanedHeightPx),
          Paint()
            ..color = AppTheme.cyan.withOpacity(0.2)
            ..style = PaintingStyle.fill,
        );
        canvas.drawLine(
          Offset(stripLeft, cleanedHeightPx),
          Offset(stripLeft + stripWidthPx, cleanedHeightPx),
          Paint()
            ..color = AppTheme.cyan.withOpacity(0.9)
            ..strokeWidth = 2.0,
        );
      }
      canvas.drawLine(
        Offset(stripLeft, 0),
        Offset(stripLeft, size.height),
        Paint()
          ..color = AppTheme.cyan.withOpacity(0.15)
          ..strokeWidth = 0.5,
      );
    }

    for (int i = 0; i <= currentStrip; i++) {
      final double stripLeft = i * stripWidthPx;
      final double cx = stripLeft + stripWidthPx / 2;
      final up = i == currentStrip
          ? upCount
          : (stripDirectionCounts[i]?['up'] ?? 0);
      final down = i == currentStrip
          ? downCount
          : (stripDirectionCounts[i]?['down'] ?? 0);

      final double dynFont = (stripWidthPx * 0.3).clamp(9.0, 16.0);

      canvas.save();
      canvas.clipRect(Rect.fromLTWH(stripLeft, 0, stripWidthPx, size.height));

      final tp1 = TextPainter(
        text: TextSpan(
          text: '↑$up',
          style: TextStyle(
            color: const Color(0xFF1ABECC),
            fontSize: dynFont,
            fontWeight: FontWeight.bold,
          ),
        ),
        textDirection: TextDirection.ltr,
        textAlign: TextAlign.center,
      )..layout(maxWidth: stripWidthPx);
      tp1.paint(canvas, Offset(cx - tp1.width / 2, 4));

      final tp2 = TextPainter(
        text: TextSpan(
          text: '↓$down',
          style: TextStyle(
            color: const Color(0xFFD85A30),
            fontSize: dynFont,
            fontWeight: FontWeight.bold,
          ),
        ),
        textDirection: TextDirection.ltr,
        textAlign: TextAlign.center,
      )..layout(maxWidth: stripWidthPx);
      tp2.paint(
        canvas,
        Offset(cx - tp2.width / 2, size.height - tp2.height - 4),
      );

      canvas.restore();
    }

    if (points.isEmpty) return;

    final pathPaint = Paint()
      ..color = AppTheme.cyan
      ..strokeWidth = 2.0
      ..strokeCap = StrokeCap.round
      ..style = PaintingStyle.stroke;
    final robotTrail = Path();
    robotTrail.moveTo(points.first.dx * scaleX, points.first.dy * scaleY);
    for (int i = 1; i < points.length; i++) {
      robotTrail.lineTo(points[i].dx * scaleX, points[i].dy * scaleY);
    }
    canvas.drawPath(robotTrail, pathPaint);

    final lastScaledX = points.last.dx * scaleX;
    final lastScaledY = points.last.dy * scaleY;
    canvas.drawCircle(
      Offset(lastScaledX, lastScaledY),
      20.0,
      Paint()..color = AppTheme.amber.withOpacity(0.2),
    );

    if (botImage != null) {
      final src = Rect.fromLTWH(
        0,
        0,
        botImage!.width.toDouble(),
        botImage!.height.toDouble(),
      );
      final double robotWidth = min(
        stripWidthPx * 0.75,
        size.width * 0.1,
      ).clamp(18.0, 38.0);
      final double robotHeight = robotWidth * 1.75;
      final dst = Rect.fromCenter(
        center: Offset(lastScaledX, lastScaledY),
        width: robotWidth,
        height: robotHeight,
      );
      canvas.drawImageRect(botImage!, src, dst, Paint());
    }
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => true;
}

