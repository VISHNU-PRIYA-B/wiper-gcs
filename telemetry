  void _parseNamedValueFloat(List<int> payload) {
    List<int> paddedPayload = List<int>.from(payload);
    while (paddedPayload.length < 18) {
      paddedPayload.add(0);
    }

    ByteData bd = ByteData.view(Uint8List.fromList(paddedPayload).buffer);
    double value = bd.getFloat32(4, Endian.little);

    String name = String.fromCharCodes(
      paddedPayload.sublist(8, 18),
    ).replaceAll('\x00', '').trim().toUpperCase();

    _lastDataTime = DateTime.now();
    if (!isConnected) isConnected = true;
    packetCount++;

    switch (name) {
      case 'STAB_FLT':
        stabFault = value > 0.5;
        break;
      case 'STAB_LATCH':
      case 'STAB_LATC':
        stabLatched = value > 0.5;
        break;
      case 'CHMBR_A_PA':
      case 'CHMBR_A_P':
      case 'CHAMB_A':
        chamberA = value.toInt();
        break;
      case 'CHMBR_B_PA':
      case 'CHMBR_B_P':
      case 'CHAMB_B':
        chamberB = value.toInt();
        break;
      case 'THRUST_1':
      case 'THRST_1':
        thrusterDc1 = value.toInt();
        break;
      case 'THRUST_2':
      case 'THRST_2':
        thrusterDc2 = value.toInt();
        break;
      case 'IMPEL_1':
        impellerDc1 = value.toInt();
        break;
      case 'IMPEL_2':
        impellerDc2 = value.toInt();
        break;
      case 'MOTN_FLT':
        motionFault = value > 0.5;
        break;
      case 'MOTION':
      case 'MOTN_ACTV':
        inMotion = value > 0.5;
        break;
      case 
        climbSpeed = value.toInt();'CLIMB_MS':
      case 'CLIMB_SPD':
        break;
      case 'ALTITUDE':
      case 'ALT':
        altitude = value.toInt();
        break;
      case 'CAPSTAN':
      case 'CAPSTN_FLT':
        capstanFault = value < 0.5;
        break;
      case 'RC_FLT':
        rcFault = value > 0.5;
        break;
      case 'RC_CONN':
        rcConnected = value > 0.5;
        break;
      case 'PWR_FLT':
        powerFault = value > 0.5;
        break;
      case 'PWR_AC':
        acSupply = value > 0.5;
        break;
      case 'BUS_48_FLT':
        bus48vFault = value > 0.5;
        break;
      case 'BUS_24_FLT':
        bus24vFault = value > 0.5;
        break;
      case 'BUS_12_FLT':
        bus12vFault = value > 0.5;
        break;
      case 'BUS_8_FLT':
        bus8vFault = value > 0.5;
        break;
      case 'BATT_V':
        batteryPct = (((value - 10.5) / 2.1) * 100).clamp(0, 100).toInt();
        break;
      case 'BATT_PCT':
        batteryPct = value.toInt();
        break;
      case 'BRUSH_1':
        brush1 = value > 0.5;
        break;
      case 'BRUSH_2':
        brush2 = value > 0.5;
        break;
      case 'WIPER_1':
        wiper1 = value > 0.5;
        break;
      case 'WIPER_2':
        wiper2 = value > 0.5;
        break;
      case 'PUMP':
        pump = value > 0.5;
        break;
      case 'WATER_LVL':
        waterLvl = value;
        break;
      case 'WATER_USD':
        waterUsed = value;
        break;
      case 'ENERGY_KWH':
      case 'ENERGY_KW':
        energyConsumed = value;
        break;
      case 'AREA_SQFT':
        areaCleaned = value;
        break;
    }
    _safeNotify();
  }

  void _safeNotify() {
    if (!_isDisposed) notifyListeners();
  }
}

